{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "*.md", "*.bat", "*.command"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**/*.@(png|jpg|mp3)", "headers": [{ "key": "Cache-Control", "value": "max-age=604800" }] },
      { "source": "index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
